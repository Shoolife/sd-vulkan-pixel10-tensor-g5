#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(set=0,binding=0) readonly buffer BX { float16_t X[]; };
layout(set=0,binding=1) writeonly buffer BC { float16_t Col[]; };
layout(push_constant) uniform P { uint Cin,Hin,Win,KH,KW,pad,stride,Wout,colOff,chunkN,imgBase,inStride; } p;
void main() {
    uint idx = gl_GlobalInvocationID.x; uint Kcol = p.Cin * p.KH * p.KW;
    if (idx >= Kcol*p.chunkN) return;
    uint k = idx / p.chunkN; uint nl = idx % p.chunkN; uint n = p.colOff + nl;
    uint khkw = p.KH * p.KW; uint ci = k / khkw; uint rem = k % khkw;
    uint ky = rem / p.KW; uint kx = rem % p.KW;
    uint oy = n / p.Wout; uint ox = n % p.Wout;
    int iy = int(oy*p.stride + ky) - int(p.pad); int ix = int(ox*p.stride + kx) - int(p.pad);
    float v = 0.0;
    if (iy>=0 && iy<int(p.Hin) && ix>=0 && ix<int(p.Win))
        v = float(X[ci*p.inStride + p.imgBase + uint(iy)*p.Win + uint(ix)]);
    Col[k*p.chunkN + nl] = float16_t(v);
}
