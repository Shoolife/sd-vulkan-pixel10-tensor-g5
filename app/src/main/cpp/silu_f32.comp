#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BX { float X[]; };
layout(set=0,binding=1) writeonly buffer BY { float Y[]; };
layout(push_constant) uniform P { uint n; } p;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=p.n) return;
    float x=float(X[i]); Y[i]=float(x/(1.0+exp(-x))); }
