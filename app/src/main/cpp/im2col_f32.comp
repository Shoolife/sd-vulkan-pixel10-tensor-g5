#version 450
// im2col со stride: X[Cin,Hin,Win] -> Col[Kcol, Ncol], Kcol=Cin*KH*KW, Ncol=Hout*Wout.
// 1 поток = 1 элемент Col. Поддерживает stride (для downsample).
layout(local_size_x = 256) in;
layout(set=0,binding=0) readonly buffer BX { float X[]; };
layout(set=0,binding=1) writeonly buffer BC { float Col[]; };
layout(push_constant) uniform P { uint Cin,Hin,Win,KH,KW,pad,stride,Wout; } p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint Hout = (p.Hin + 2u*p.pad - p.KH)/p.stride + 1u;
    uint Ncol = Hout * p.Wout;
    uint Kcol = p.Cin * p.KH * p.KW;
    if (idx >= Kcol*Ncol) return;
    uint k = idx / Ncol;            // строка Col (ci,ky,kx)
    uint n = idx % Ncol;            // столбец (oy,ox)
    uint khkw = p.KH * p.KW;
    uint ci = k / khkw; uint rem = k % khkw;
    uint ky = rem / p.KW; uint kx = rem % p.KW;
    uint oy = n / p.Wout; uint ox = n % p.Wout;
    int iy = int(oy*p.stride + ky) - int(p.pad);
    int ix = int(ox*p.stride + kx) - int(p.pad);
    float v = 0.0;
    if (iy>=0 && iy<int(p.Hin) && ix>=0 && ix<int(p.Win))
        v = X[ci*p.Hin*p.Win + uint(iy)*p.Win + uint(ix)];
    Col[idx] = v;
}
