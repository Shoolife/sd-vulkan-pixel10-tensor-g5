#version 450
// fp32. 128×128 тайл, 256 потоков, поток считает 8 строк × 2 vec4 (8×8=64 выхода).
// vs matmul.comp: A в shared хранится как vec4 (4 строки в одном vec4) → 2 vec4-чтения
// вместо 8 скалярных на каждый k. Цель: снять упор в bandwidth shared-памяти.
#define BM 128
#define BN 128
#define BK 4
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) readonly buffer BufA { float A[]; };
layout(set = 0, binding = 1) readonly buffer BufB { vec4 B4[]; };
layout(set = 0, binding = 2) writeonly buffer BufC { vec4 C4[]; };
// Nfull/colOffV: C — подматрица столбцов в выходе шириной Nfull (для N-тайлинга conv).
// обычный matmul: Nfull=N, colOffV=0.
layout(push_constant) uniform Push { uint M, N, K, Nfull, colOffV; } p;

shared vec4 As[BK][BM/4];   // транспонированная A: As[k][r4] = строки r4*4..+3 на глубине k
shared vec4 Bs[BK][BN/4];

void main() {
    uint tid = gl_LocalInvocationID.y * 16u + gl_LocalInvocationID.x;
    uint blockRow = gl_WorkGroupID.y * BM;
    uint blockCol = gl_WorkGroupID.x * BN;
    uint N4 = p.N / 4u;
    uint tr4 = (tid / 16u) * 2u;     // 2 vec4 строки на поток (=8 строк)
    uint tcv = (tid % 16u) * 2u;     // 2 vec4 столбца

    vec4 acc0[8]; vec4 acc1[8];
    for (int i=0;i<8;i++){ acc0[i]=vec4(0.0); acc1[i]=vec4(0.0); }

    uint tiles = (p.K + BK - 1u) / BK;
    for (uint t = 0u; t < tiles; t++) {
        // загрузка A с транспонированием, запись по компонентам vec4
        for (uint i = tid; i < BM*BK; i += 256u) {
            uint r = i / BK, c = i % BK;
            uint gr = blockRow + r, gc = t*BK + c;
            As[c][r >> 2u][r & 3u] = (gr < p.M && gc < p.K) ? A[gr*p.K + gc] : 0.0;
        }
        for (uint i = tid; i < BK*(BN/4u); i += 256u) {
            uint r = i / (BN/4u), c = i % (BN/4u);
            uint gr = t*BK + r; uint gcv = blockCol/4u + c;
            Bs[r][c] = (gr < p.K && gcv < N4) ? B4[gr*N4 + gcv] : vec4(0.0);
        }
        barrier();
        for (uint k = 0u; k < BK; k++) {
            vec4 a0 = As[k][tr4]; vec4 a1 = As[k][tr4+1u];
            vec4 b0 = Bs[k][tcv]; vec4 b1 = Bs[k][tcv+1u];
            acc0[0]+=a0.x*b0; acc1[0]+=a0.x*b1;
            acc0[1]+=a0.y*b0; acc1[1]+=a0.y*b1;
            acc0[2]+=a0.z*b0; acc1[2]+=a0.z*b1;
            acc0[3]+=a0.w*b0; acc1[3]+=a0.w*b1;
            acc0[4]+=a1.x*b0; acc1[4]+=a1.x*b1;
            acc0[5]+=a1.y*b0; acc1[5]+=a1.y*b1;
            acc0[6]+=a1.z*b0; acc1[6]+=a1.z*b1;
            acc0[7]+=a1.w*b0; acc1[7]+=a1.w*b1;
        }
        barrier();
    }
    uint cv = blockCol/4u + tcv;
    uint N4full = p.Nfull / 4u;
    for (uint i = 0u; i < 8u; i++) {
        uint gr = blockRow + tr4*4u + i;
        if (gr < p.M){ uint base = gr*N4full + p.colOffV;
            if(cv<N4) C4[base + cv]=acc0[i]; if(cv+1u<N4) C4[base + cv+1u]=acc1[i]; }
    }
}
