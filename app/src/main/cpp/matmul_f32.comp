#version 450
// fp16 storage, FP32 accumulate (как tensor cores) — точность + скорость.
// workgroup 16×16, поток считает 8 строк × 2 vec4 (8×8=64 выхода). Тайл 128×128.
#define BM 128
#define BN 128
#define BK 16
#define TM 8
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) readonly buffer BufA { float A[]; };
layout(set = 0, binding = 1) readonly buffer BufB { vec4 B4[]; };
layout(set = 0, binding = 2) writeonly buffer BufC { vec4 C4[]; };
layout(push_constant) uniform Push { uint M, N, K; } p;

shared float As[BK][BM];
shared vec4  Bs[BK][BN/4];

void main() {
    uint tid = gl_LocalInvocationID.y * 16u + gl_LocalInvocationID.x;
    uint blockRow = gl_WorkGroupID.y * BM;
    uint blockCol = gl_WorkGroupID.x * BN;
    uint N4 = p.N / 4u;
    uint tr  = (tid / 16u) * TM;
    uint tcv = (tid % 16u) * 2u;

    vec4 acc0[TM]; vec4 acc1[TM];          // FP32 аккумуляторы
    for (int i=0;i<TM;i++){ acc0[i]=vec4(0.0); acc1[i]=vec4(0.0); }

    uint tiles = (p.K + BK - 1u) / BK;
    for (uint t = 0u; t < tiles; t++) {
        for (uint i = tid; i < BM*BK; i += 256u) {
            uint r = i / BK, c = i % BK;
            uint gr = blockRow + r, gc = t*BK + c;
            As[c][r] = (gr < p.M && gc < p.K) ? A[gr*p.K + gc] : float(0.0);
        }
        for (uint i = tid; i < BK*(BN/4u); i += 256u) {
            uint r = i / (BN/4u), c = i % (BN/4u);
            uint gr = t*BK + r; uint gcv = blockCol/4u + c;
            Bs[r][c] = (gr < p.K && gcv < N4) ? B4[gr*N4 + gcv] : vec4(0.0);
        }
        barrier();
        for (uint k = 0u; k < BK; k++) {
            vec4 b0 = vec4(Bs[k][tcv]); vec4 b1 = vec4(Bs[k][tcv+1u]);  // fp16→fp32
            for (int i=0;i<TM;i++){ float a = float(As[k][tr+i]); acc0[i]+=a*b0; acc1[i]+=a*b1; }
        }
        barrier();
    }
    for (int i=0;i<TM;i++){
        uint gr = blockRow + tr + i;
        uint cv=blockCol/4u + tcv;
        if (gr < p.M){ if(cv<N4) C4[gr*N4 + cv]=vec4(acc0[i]); if(cv+1u<N4) C4[gr*N4 + cv+1u]=vec4(acc1[i]); }
    }
}
