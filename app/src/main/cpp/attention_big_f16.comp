#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define TQ 128
#define TK 16
#define MAXDD 40
layout(local_size_x = TQ) in;
layout(set=0,binding=0) readonly buffer BQ { f16vec4 Q[]; };
layout(set=0,binding=1) readonly buffer BK { f16vec4 K[]; };
layout(set=0,binding=2) readonly buffer BV { f16vec4 V[]; };
layout(set=0,binding=3) writeonly buffer BO { f16vec4 O[]; };
layout(push_constant) uniform P { uint seqQ, seqK, d, H, seqQpi, seqKpi; float scale; } p;
shared f16vec4 Ks[TK][MAXDD];   // K в f16 (packed score-dot)
shared vec4    Vs[TK][MAXDD];   // V в fp32 (точная аккумуляция)
void main(){
    uint tid=gl_LocalInvocationID.x;
    uint blocksPerImg=(p.seqQpi+TQ-1u)/TQ; uint img=gl_WorkGroupID.x/blocksPerImg; uint qb=gl_WorkGroupID.x%blocksPerImg;
    uint i=img*p.seqQpi + qb*TQ + tid; uint h=gl_WorkGroupID.y;
    uint dd=p.d>>2; bool inr=(qb*TQ+tid<p.seqQpi)&&(h<p.H);
    f16vec4 q[MAXDD]; uint qv=(h*p.seqQ+i)*dd;
    if(inr) for(uint k=0u;k<dd;k++) q[k]=Q[qv+k];
    vec4 acc[MAXDD]; for(uint k=0u;k<dd;k++) acc[k]=vec4(0.0);
    float m=-3.0e38,l=0.0; uint hkv=h*p.seqK*dd; const float L2E=1.442695041f;
    uint kStart=img*p.seqKpi, kEnd=kStart+p.seqKpi;
    for(uint kb=kStart;kb<kEnd;kb+=TK){
        for(uint t=tid;t<TK;t+=TQ){ uint jg=kb+t;
            if(jg<kEnd) for(uint k=0u;k<dd;k++){ Ks[t][k]=K[hkv+jg*dd+k]; Vs[t][k]=vec4(V[hkv+jg*dd+k]); } }
        barrier();
        if(inr){ uint cnt=min(uint(TK),kEnd-kb);
            for(uint jj=0u;jj<cnt;jj++){ float16_t sf=float16_t(0.0); for(uint k=0u;k<dd;k++) sf+=dot(q[k],Ks[jj][k]); float s=float(sf)*p.scale;
                if(s>m){ float cr=exp2((m-s)*L2E); l*=cr; for(uint k=0u;k<dd;k++) acc[k]*=cr; m=s; }
                float pj=exp2((s-m)*L2E); l+=pj;
                for(uint k=0u;k<dd;k++) acc[k]+=pj*Vs[jj][k]; } }
        barrier();
    }
    if(inr){ uint ov=(h*p.seqQ+i)*dd; float il=1.0/l; for(uint k=0u;k<dd;k++) O[ov+k]=f16vec4(acc[k]*il); }
}
