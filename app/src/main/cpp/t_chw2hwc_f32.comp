#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BX { float X[]; };
layout(set=0,binding=1) writeonly buffer BY { float Y[]; };
layout(push_constant) uniform P { uint C, HW; } p;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=p.C*p.HW) return;
    uint c=i/p.HW, hw=i%p.HW; Y[hw*p.C+c]=X[i]; }
