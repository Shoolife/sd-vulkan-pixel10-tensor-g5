#version 450
// Flash-attention, fp32, vec4, TQ=128. Оптимизация: УСЛОВНЫЙ rescale аккумулятора —
// acc*=corr делаем только когда max вырос (s>m); иначе пропускаем (corr=1). max
// стабилизируется быстро → большинство ключей пропускают 10 vec4-умножений. + exp2 (нативный).
#define TQ 128
#define TK 32
#define MAXDD 10
layout(local_size_x = TQ) in;
layout(set=0,binding=0) readonly buffer BQ { vec4 Q[]; };
layout(set=0,binding=1) readonly buffer BK { vec4 K[]; };
layout(set=0,binding=2) readonly buffer BV { vec4 V[]; };
layout(set=0,binding=3) writeonly buffer BO { vec4 O[]; };
layout(push_constant) uniform P { uint seqQ, seqK, d, H; float scale; } p;

shared vec4 Ks[TK][MAXDD];
shared vec4 Vs[TK][MAXDD];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint i = gl_WorkGroupID.x * TQ + tid;
    uint h = gl_WorkGroupID.y;
    uint dd = p.d >> 2;
    bool inrange = (i < p.seqQ) && (h < p.H);
    const float L2E = 1.442695041f;          // log2(e): exp(x)=exp2(x*L2E)

    vec4 q[MAXDD];
    uint qv = (h*p.seqQ + i)*dd;
    if (inrange) for (uint k=0u;k<dd;k++) q[k]=Q[qv+k];

    vec4 acc[MAXDD];
    for (uint k=0u;k<dd;k++) acc[k]=vec4(0.0);
    float m=-3.0e38, l=0.0;
    uint hkv = h*p.seqK*dd;

    for (uint kb=0u; kb<p.seqK; kb+=TK) {
        for (uint t=tid; t<TK; t+=TQ) {
            uint jg = kb + t;
            if (jg < p.seqK) for (uint k=0u;k<dd;k++){ Ks[t][k]=K[hkv+jg*dd+k]; Vs[t][k]=V[hkv+jg*dd+k]; }
        }
        barrier();
        if (inrange) {
            uint cnt = min(uint(TK), p.seqK-kb);
            for (uint jj=0u; jj<cnt; jj++) {
                float s=0.0;
                for (uint k=0u;k<dd;k++) s += dot(q[k], Ks[jj][k]);
                s *= p.scale;
                if (s > m) {                                   // max вырос — rescale
                    float corr = exp2((m - s) * L2E);
                    l *= corr;
                    for (uint k=0u;k<dd;k++) acc[k] *= corr;
                    m = s;
                }
                float pj = exp2((s - m) * L2E);
                l += pj;
                for (uint k=0u;k<dd;k++) acc[k] += pj * Vs[jj][k];
            }
        }
        barrier();
    }
    if (inrange) {
        uint ov=(h*p.seqQ+i)*dd; float invl=1.0/l;
        for (uint k=0u;k<dd;k++) O[ov+k]=acc[k]*invl;
    }
}
