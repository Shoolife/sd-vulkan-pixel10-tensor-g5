#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BX { float16_t X[]; };
layout(set=0,binding=1) writeonly buffer BY { float16_t Y[]; };
layout(push_constant) uniform P { uint C, H, W, B; } p;
void main(){ uint i=gl_GlobalInvocationID.x; uint Ho=p.H*2u, Wo=p.W*2u;
    uint outImg=Ho*Wo, inImg=p.H*p.W, rowO=p.B*outImg, rowI=p.B*inImg;
    if(i>=p.C*rowO) return;
    uint c=i/rowO; uint w=i%rowO; uint b=w/outImg; uint r=w%outImg; uint oy=r/Wo, ox=r%Wo;
    Y[i]=X[c*rowI + b*inImg + (oy/2u)*p.W + (ox/2u)]; }
