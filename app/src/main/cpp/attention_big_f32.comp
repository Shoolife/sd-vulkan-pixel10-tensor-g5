#version 450
// Flash-attention для d<=160 (MAXDD=40). TQ=128 (полный subgroup PowerVR),
// K/V-тайл TK=16 (shared Ks+Vs = 16*40*16*2 = 20КБ < 32КБ). Развязка как в attention2.
#define TQ 128
#define TK 16
#define MAXDD 40
layout(local_size_x = TQ) in;
layout(set=0,binding=0) readonly buffer BQ { vec4 Q[]; };
layout(set=0,binding=1) readonly buffer BK { vec4 K[]; };
layout(set=0,binding=2) readonly buffer BV { vec4 V[]; };
layout(set=0,binding=3) writeonly buffer BO { vec4 O[]; };
layout(push_constant) uniform P { uint seqQ, seqK, d, H; float scale; } p;
shared vec4 Ks[TK][MAXDD];
shared vec4 Vs[TK][MAXDD];
void main(){
    uint tid=gl_LocalInvocationID.x; uint i=gl_WorkGroupID.x*TQ+tid; uint h=gl_WorkGroupID.y;
    uint dd=p.d>>2; bool inr=(i<p.seqQ)&&(h<p.H);
    vec4 q[MAXDD]; uint qv=(h*p.seqQ+i)*dd;
    if(inr) for(uint k=0u;k<dd;k++) q[k]=Q[qv+k];
    vec4 acc[MAXDD]; for(uint k=0u;k<dd;k++) acc[k]=vec4(0.0);
    float m=-3.0e38,l=0.0; uint hkv=h*p.seqK*dd;
    for(uint kb=0u;kb<p.seqK;kb+=TK){
        for(uint t=tid;t<TK;t+=TQ){ uint jg=kb+t;
            if(jg<p.seqK) for(uint k=0u;k<dd;k++){ Ks[t][k]=K[hkv+jg*dd+k]; Vs[t][k]=V[hkv+jg*dd+k]; } }
        barrier();
        if(inr){ uint cnt=min(uint(TK),p.seqK-kb);
            for(uint jj=0u;jj<cnt;jj++){ float s=0.0; for(uint k=0u;k<dd;k++) s+=dot(q[k],Ks[jj][k]); s*=p.scale;
                float mn=max(m,s); float cr=exp(m-mn); float pj=exp(s-mn); l=l*cr+pj;
                for(uint k=0u;k<dd;k++) acc[k]=acc[k]*cr+pj*Vs[jj][k]; m=mn; } }
        barrier();
    }
    if(inr){ uint ov=(h*p.seqQ+i)*dd; float il=1.0/l; for(uint k=0u;k<dd;k++) O[ov+k]=acc[k]*il; }
}
