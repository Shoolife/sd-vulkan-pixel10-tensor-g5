#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BX { float16_t X[]; };
layout(set=0,binding=1) writeonly buffer BY { float16_t Y[]; };
layout(push_constant) uniform P { uint seq, nh, d; } p;
void main(){ uint i=gl_GlobalInvocationID.x; uint C=p.nh*p.d; if(i>=p.seq*C) return;
    uint h=i/(p.seq*p.d); uint rem=i%(p.seq*p.d); uint s=rem/p.d, k=rem%p.d;
    Y[s*C + h*p.d + k]=X[i]; }
