#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BX { float16_t X[]; };
layout(set=0,binding=1) writeonly buffer BY { float16_t Y[]; };
layout(push_constant) uniform P { uint n; } p;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=p.n) return; float x=float(X[i]);
    float c=0.7978845608*(x+0.044715*x*x*x);
    Y[i]=float16_t(0.5*x*(1.0+tanh(c))); }
