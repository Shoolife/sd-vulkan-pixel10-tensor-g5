#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BA { float16_t A[]; };
layout(set=0,binding=1) readonly buffer BB { float16_t B[]; };
layout(set=0,binding=2) writeonly buffer BY { float16_t Y[]; };
layout(push_constant) uniform P { uint n; } p;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=p.n) return;
    Y[i]=float16_t(float(A[i])+float(B[i])); }
