#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer BA { float A[]; };
layout(set=0,binding=1) readonly buffer BB { float B[]; };
layout(set=0,binding=2) writeonly buffer BY { float Y[]; };
layout(push_constant) uniform P { uint n; } p;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=p.n) return;
    Y[i]=float(float(A[i])+float(B[i])); }
