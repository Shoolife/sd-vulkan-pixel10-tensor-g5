#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0) buffer BY { float Y[]; };
layout(set=0,binding=1) readonly buffer BB { float B[]; };
layout(push_constant) uniform P { uint C, HW; } p;
void main(){ uint i=gl_GlobalInvocationID.x; if(i>=p.C*p.HW) return;
    uint c=i/p.HW; Y[i]=float(float(Y[i])+float(B[c])); }
