FROM ubuntu:22.04
RUN apt-get update -qq && apt-get install -y -qq python3 python3-pip curl && rm -rf /var/lib/apt/lists/*
RUN pip install -q ai-edge-litert-nightly==2.2.0.dev20260520 numpy
COPY _sdk.tar.gz /sdk.tar.gz
RUN GOOGLE_TENSOR_SDK_BETA=/sdk.tar.gz pip install -q ai-edge-litert-sdk-google-tensor==2.1.5
